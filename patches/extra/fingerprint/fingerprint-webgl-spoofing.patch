+#include "gpu/command_buffer/service/webgl_debug_renderer_info.h"
+
+#include "base/command_line.h"
+
+namespace gpu {
+
+const char kFingerprintWebGLVendor[] = "fingerprint-webgl-vendor";
+const char kFingerprintWebGLRenderer[] = "fingerprint-webgl-renderer";
+
+bool ShouldSpoofWebGLInfo(std::string* vendor, std::string* renderer) {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+
+  bool should_spoof = false;
+
+  if (command_line->HasSwitch(kFingerprintWebGLVendor)) {
+    *vendor = command_line->GetSwitchValueASCII(kFingerprintWebGLVendor);
+    should_spoof = true;
+  }
+
+  if (command_line->HasSwitch(kFingerprintWebGLRenderer)) {
+    *renderer = command_line->GetSwitchValueASCII(kFingerprintWebGLRenderer);
+    should_spoof = true;
+  }
+
+  return should_spoof;
+}
+
+}  // namespace gpu
