+// Parse media devices config: "audio:2,video:1,audiooutput:1"
+HeapVector<Member<MediaDeviceInfo>> CreateSpoofedDevices(
+    ExecutionContext* context,
+    const std::string& config) {
+  HeapVector<Member<MediaDeviceInfo>> devices;
+
+  // Parse config string
+  int audio_inputs = 1;
+  int video_inputs = 1;
+  int audio_outputs = 1;
+
+  std::vector<std::string> parts = base::SplitString(
+      config, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+
+  for (const auto& part : parts) {
+    std::vector<std::string> kv = base::SplitString(
+        part, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (kv.size() == 2) {
+      int count = 0;
+      base::StringToInt(kv[1], &count);
+      if (kv[0] == "audio") audio_inputs = count;
+      else if (kv[0] == "video") video_inputs = count;
+      else if (kv[0] == "audiooutput") audio_outputs = count;
+    }
+  }
+
+  // Use a seed based on origin for consistent device IDs per site
+  uint64_t seed = base::RandUint64();
+
+  // Create fake audio inputs
+  for (int i = 0; i < audio_inputs; i++) {
+    String device_id = GenerateFakeDeviceId("audioinput", i, seed);
+    String group_id = GenerateFakeDeviceId("group-audio", i, seed);
+    String label = i == 0 ? "Default Microphone" : String::Format("Microphone %d", i + 1);
+    devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+        device_id, label, group_id, "audioinput"));
+  }
+
+  // Create fake video inputs
+  for (int i = 0; i < video_inputs; i++) {
+    String device_id = GenerateFakeDeviceId("videoinput", i, seed);
+    String group_id = GenerateFakeDeviceId("group-video", i, seed);
+    String label = i == 0 ? "Integrated Camera" : String::Format("Camera %d", i + 1);
+    devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+        device_id, label, group_id, "videoinput"));
+  }
+
+  // Create fake audio outputs
+  for (int i = 0; i < audio_outputs; i++) {
+    String device_id = GenerateFakeDeviceId("audiooutput", i, seed);
+    String group_id = GenerateFakeDeviceId("group-audioout", i, seed);
+    String label = i == 0 ? "Default Speakers" : String::Format("Speakers %d", i + 1);
+    devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+        device_id, label, group_id, "audiooutput"));
+  }
+
+  return devices;
+}
