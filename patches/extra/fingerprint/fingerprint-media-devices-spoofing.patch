+// Generate a deterministic fake device ID based on profile seed
+String GenerateFakeDeviceId(const String& kind, int index, uint64_t seed) {
+  // Create a deterministic hash for consistent device IDs per profile
+  uint64_t hash = seed;
+  for (wtf_size_t i = 0; i < kind.length(); i++) {
+    hash = hash * 31 + kind[i];
+  }
+  hash = hash * 31 + index;
+
+  // Format as a device ID (similar to real Chrome device IDs)
+  char buffer[65];
+  snprintf(buffer, sizeof(buffer),
+           "%016llx%016llx%016llx%016llx",
+           (unsigned long long)(hash),
+           (unsigned long long)(hash ^ 0xDEADBEEF),
+           (unsigned long long)(hash ^ 0xCAFEBABE),
+           (unsigned long long)(hash ^ 0x12345678));
+  return String(buffer);
+}
