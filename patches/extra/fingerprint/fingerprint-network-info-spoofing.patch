+// Parse network type from string
+WebConnectionType ParseNetworkType(const std::string& type_str) {
+  if (type_str == "wifi") return kWebConnectionTypeWifi;
+  if (type_str == "ethernet") return kWebConnectionTypeEthernet;
+  if (type_str == "cellular") return kWebConnectionTypeCellular4G;
+  if (type_str == "4g") return kWebConnectionTypeCellular4G;
+  if (type_str == "3g") return kWebConnectionTypeCellular3G;
+  if (type_str == "2g") return kWebConnectionTypeCellular2G;
+  if (type_str == "bluetooth") return kWebConnectionTypeBluetooth;
+  if (type_str == "none") return kWebConnectionTypeNone;
+  return kWebConnectionTypeWifi;  // Default to wifi
+}
+
+// Parse effective connection type from string
+EffectiveConnectionType ParseEffectiveType(const std::string& type_str) {
+  if (type_str == "4g") return EffectiveConnectionType::kType4G;
+  if (type_str == "3g") return EffectiveConnectionType::kType3G;
+  if (type_str == "2g") return EffectiveConnectionType::kType2G;
+  if (type_str == "slow-2g") return EffectiveConnectionType::kTypeSlow2G;
+  return EffectiveConnectionType::kType4G;  // Default to 4g
+}
+
+// Get downlink speed based on effective type
+double GetDownlinkForEffectiveType(EffectiveConnectionType type) {
+  switch (type) {
+    case EffectiveConnectionType::kType4G:
+      return 10.0;  // 10 Mbps
+    case EffectiveConnectionType::kType3G:
+      return 1.5;   // 1.5 Mbps
+    case EffectiveConnectionType::kType2G:
+      return 0.3;   // 300 Kbps
+    case EffectiveConnectionType::kTypeSlow2G:
+      return 0.05;  // 50 Kbps
+    default:
+      return 10.0;
+  }
+}
+
+// Get RTT based on effective type
+unsigned long GetRttForEffectiveType(EffectiveConnectionType type) {
+  switch (type) {
+    case EffectiveConnectionType::kType4G:
+      return 50;    // 50ms
+    case EffectiveConnectionType::kType3G:
+      return 300;   // 300ms
+    case EffectiveConnectionType::kType2G:
+      return 700;   // 700ms
+    case EffectiveConnectionType::kTypeSlow2G:
+      return 2000;  // 2000ms
+    default:
+      return 50;
+  }
+}
+
+// Check if network info API is disabled or spoofed
+bool ShouldSpoofNetworkInfo(WebConnectionType* out_type,
+                            EffectiveConnectionType* out_effective_type) {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+
+  if (command_line->HasSwitch(kFingerprintNetworkType) ||
+      command_line->HasSwitch(kFingerprintNetworkEffectiveType)) {
+    *out_type = ParseNetworkType(
+        command_line->GetSwitchValueASCII(kFingerprintNetworkType));
+    *out_effective_type = ParseEffectiveType(
+        command_line->GetSwitchValueASCII(kFingerprintNetworkEffectiveType));
+    return true;
+  }
+
+  return false;
+}
+
