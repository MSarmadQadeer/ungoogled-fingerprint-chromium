 namespace blink {

+// Command-line switches
+const char kFingerprintNetworkType[] = "fingerprint-network-type";
+const char kFingerprintNetworkEffectiveType[] = "fingerprint-network-effective-type";
+const char kDisableNetworkInfoAPI[] = "disable-network-info-api";
