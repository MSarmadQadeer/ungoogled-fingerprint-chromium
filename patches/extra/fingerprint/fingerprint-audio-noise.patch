# Audio Context Fingerprinting Noise for Profile Grid
# Adds noise to AudioContext fingerprinting vectors
# --fingerprinting-audio-noise enables audio fingerprint deception
# --fingerprint-audio-seed=12345 sets deterministic noise seed per profile

--- a/third_party/blink/renderer/modules/webaudio/analyser_node.cc
+++ b/third_party/blink/renderer/modules/webaudio/analyser_node.cc
@@ -24,6 +24,9 @@

 #include "third_party/blink/renderer/modules/webaudio/analyser_node.h"

+#include "base/command_line.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
 #include "third_party/blink/renderer/bindings/modules/v8/v8_analyser_options.h"
 #include "third_party/blink/renderer/modules/webaudio/analyser_handler.h"
 #include "third_party/blink/renderer/modules/webaudio/audio_graph_tracer.h"
@@ -31,6 +34,41 @@

 namespace blink {

+// Command-line switches for audio fingerprinting
+const char kFingerprintingAudioNoise[] = "fingerprinting-audio-noise";
+const char kFingerprintAudioSeed[] = "fingerprint-audio-seed";
+
+// Get noise factor for audio fingerprinting
+double GetAudioNoiseFactor() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+
+  if (!command_line->HasSwitch(kFingerprintingAudioNoise)) {
+    return 0.0;
+  }
+
+  // Use seed if provided, otherwise random
+  uint64_t seed = 0;
+  if (command_line->HasSwitch(kFingerprintAudioSeed)) {
+    base::StringToUint64(
+        command_line->GetSwitchValueASCII(kFingerprintAudioSeed), &seed);
+  } else {
+    seed = base::RandUint64();
+  }
+
+  // Create deterministic noise factor from seed
+  // Range: -0.0001 to +0.0001 (imperceptible but changes fingerprint)
+  double noise = ((double)(seed % 10000) / 10000.0 - 0.5) * 0.0002;
+  return noise;
+}
+
+// Apply noise to a float buffer
+void ApplyAudioNoise(float* buffer, unsigned length, double noise_factor) {
+  if (noise_factor == 0.0) return;
+
+  for (unsigned i = 0; i < length; i++) {
+    buffer[i] = buffer[i] * (1.0 + noise_factor);
+  }
+}
+
 AnalyserNode* AnalyserNode::Create(BaseAudioContext& context,
                                    ExceptionState& exception_state) {
   DCHECK(IsMainThread());
